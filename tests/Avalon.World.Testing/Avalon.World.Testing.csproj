<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The world test support shared by the world unit tests and the scenario baseline: hand-written fakes that do not
    allocate (QuietWorld, QuietConnection), so the tick paths they serve can be pinned at zero bytes. A library, not a
    test project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Server\Avalon.World\Avalon.World.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Common\Avalon.Common.csproj"/>
  </ItemGroup>

</Project>
