# Every text file is LF, in the index and in the working copy, on every platform (#1086). This overrides
# core.autocrlf, so a Windows checkout is LF too and .editorconfig's end_of_line = lf agrees with what is on disk.
# Several files depend on it: the generated wire schema (*.proto, schema/**), the balance files and the golden CSV
# (balance/*.json, tests/Avalon.Balance.UnitTests/Golden/*.csv), the chunk catalog (src/Server/Avalon.Server.World/Maps/**)
# and ChunkGen's Kit/ and Recipes/ JSON are written by tools or compared byte for byte by tests, so a regeneration on
# any machine must be an empty diff; the CI scripts (tools/ci/*.sh) run under bash, where a CR breaks them.
* text=auto eol=lf

# Windows command scripts stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries: never converted, never diffed as text.
*.ico binary
*.pfx binary
*.snk binary
