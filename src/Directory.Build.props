<Project>
  <!-- The repository-wide code standard (EnforceCodeStyleInBuild, documentation file, warnings as errors in CI). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8618;CS8600</NoWarn>
    <AssemblyOriginatorKeyFile>..\..\..\sgKey.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    CI enforces CancellationToken hygiene as errors. GitHub Actions auto-sets CI=true;
    so do most other providers (GitLab, Azure Pipelines, Travis, CircleCI). Local dev
    builds see the same rules as warnings (see .editorconfig) so they are visible but
    non-blocking.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);MA0032;MA0040;MA0045</WarningsAsErrors>
    <!--
      Meziantou.Analyzer's other rules that are on by default, with the warnings src had when the code standard came
      in (#791): reported, not fatal, until each is fixed or given a severity of its own. They are not part of the
      standard; the CancellationToken rules above are.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);MA0002;MA0006;MA0008;MA0009;MA0010;MA0011;MA0012;MA0015;MA0016;MA0021;MA0022;MA0025;MA0026;MA0046;MA0048;MA0051;MA0054;MA0061;MA0069;MA0074;MA0077;MA0084;MA0088;MA0099;MA0132;MA0134;MA0158</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\sgKey.snk">
      <Link>sgKey.snk</Link>
    </None>

    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
