<Project>
  <!-- The repository-wide code standard (EnforceCodeStyleInBuild, documentation file, warnings as errors in CI). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8618;CS8600</NoWarn>
    <AssemblyOriginatorKeyFile>..\..\..\sgKey.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    CI enforces CancellationToken hygiene as errors. GitHub Actions auto-sets CI=true;
    so do most other providers (GitLab, Azure Pipelines, Travis, CircleCI). Local dev
    builds see the same rules as warnings (see .editorconfig) so they are visible but
    non-blocking.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);MA0032;MA0040;MA0045</WarningsAsErrors>
    <!--
      Meziantou.Analyzer's correctness rules (string comparers, regex timeouts, culture, inner exceptions, unobserved
      tasks, default values, DateTimeOffset conversions) had about 45 warnings in src when the code standard came in
      (#791). They are reported but not fatal until #793 fixes them; then this list goes. Its opinion rules are off
      in .editorconfig.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);MA0002;MA0009;MA0011;MA0022;MA0054;MA0061;MA0074;MA0132;MA0134</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\sgKey.snk">
      <Link>sgKey.snk</Link>
    </None>

    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
