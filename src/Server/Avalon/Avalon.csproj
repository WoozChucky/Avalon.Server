<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>13ebf485-c479-4f1c-9f4f-e70375918011</UserSecretsId>
    <!-- ASPIRE010: the AppHost runs without the Aspire CLI bundle, from dotnet run or the IDE. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.3"/>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost"/>
  </ItemGroup>

  <!-- Aspire.Hosting 13.6.1 brings MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h: a crash on hostile nested arrays). This host
       only exchanges MessagePack with the local Aspire processes it starts, so the advisory is suppressed here alone;
       any other advisory still fails the restore. Drop it once Aspire brings MessagePack 2.5.303 or later. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalon.Api\Avalon.Api.csproj"/>
    <ProjectReference Include="..\Avalon.Balance.Service\Avalon.Balance.Service.csproj"/>
    <ProjectReference Include="..\Avalon.Server.World\Avalon.Server.World.csproj"/>
  </ItemGroup>

</Project>
