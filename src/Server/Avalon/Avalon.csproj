<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>13ebf485-c479-4f1c-9f4f-e70375918011</UserSecretsId>
    <!-- ASPIRE010: the AppHost runs without the Aspire CLI bundle, from dotnet run or the IDE. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1"/>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalon.Api\Avalon.Api.csproj"/>
    <ProjectReference Include="..\Avalon.Balance.Service\Avalon.Balance.Service.csproj"/>
    <ProjectReference Include="..\Avalon.Server.Auth\Avalon.Server.Auth.csproj"/>
    <ProjectReference Include="..\Avalon.Server.World\Avalon.Server.World.csproj"/>
  </ItemGroup>

</Project>
