<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The API hosting every API service shares (#794, design section 3.1): the host builder and the one pipeline,
    startup (options, the auth schema, the world databases, Redis), token validation, rate limiting, forwarded
    headers, problem details, the controllers' base class, the OpenAPI conventions, the world database plumbing and
    the route manifest. It references no API service and not the host.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK's implicit usings, which the code moved here from Avalon.Api was written against. -->
    <Using Include="Microsoft.AspNetCore.Builder"/>
    <Using Include="Microsoft.AspNetCore.Hosting"/>
    <Using Include="Microsoft.AspNetCore.Http"/>
    <Using Include="Microsoft.AspNetCore.Routing"/>
    <Using Include="Microsoft.Extensions.Configuration"/>
    <Using Include="Microsoft.Extensions.DependencyInjection"/>
    <Using Include="Microsoft.Extensions.Hosting"/>
    <Using Include="Microsoft.Extensions.Logging"/>
    <Using Include="System.Net.Http.Json"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    <PackageReference Include="Scalar.AspNetCore"/>
    <PackageReference Include="StackExchange.Redis"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Avalon.Common\Avalon.Common.csproj"/>
    <ProjectReference Include="..\..\Shared\Avalon.Domain\Avalon.Domain.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Contract\Avalon.Api.Contract.csproj"/>
    <ProjectReference Include="..\Avalon.Database\Avalon.Database.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Auth\Avalon.Database.Auth.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Character\Avalon.Database.Character.csproj"/>
    <ProjectReference Include="..\Avalon.Database.World\Avalon.Database.World.csproj"/>
    <ProjectReference Include="..\Avalon.Hosting\Avalon.Hosting.csproj"/>
    <ProjectReference Include="..\Avalon.Infrastructure\Avalon.Infrastructure.csproj"/>
    <ProjectReference Include="..\Avalon.ServiceDefaults\Avalon.ServiceDefaults.csproj"/>
  </ItemGroup>

</Project>
