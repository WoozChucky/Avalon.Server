<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Holds the signing keys (Application:Authentication:SigningKey, Application:GameAuth:HostKey) in development; never committed (#482, #801). -->
    <UserSecretsId>5c959363-ba65-4b68-9e09-73549b17023b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    <!-- Emits the OpenAPI document during build so the docs site and the dashboard's
         drift check can read the contract without running the API. Build-only: it
         contributes nothing to the shipped output. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Otp.NET"/>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Enrichers.Thread"/>
    <PackageReference Include="Serilog.Extensions.Logging"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="StackExchange.Redis"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The chunk assets the map endpoints serve live with the World server. Deployments read
         them from the output (Application:MapAssets:ChunkAssetRoot=/app/Maps); dotnet run keeps
         the appsettings path into the World project. -->
    <None Include="..\Avalon.Server.World\Maps\**" Link="Maps\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Avalon.Common\Avalon.Common.csproj"/>
    <ProjectReference Include="..\..\Shared\Avalon.Configuration\Avalon.Configuration.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Commerce\Avalon.Api.Commerce.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Contract\Avalon.Api.Contract.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Distribution\Avalon.Api.Distribution.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Hosting\Avalon.Api.Hosting.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Identity\Avalon.Api.Identity.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Worlds\Avalon.Api.Worlds.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Auth\Avalon.Database.Auth.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Character\Avalon.Database.Character.csproj"/>
    <ProjectReference Include="..\Avalon.Database.World\Avalon.Database.World.csproj"/>
    <ProjectReference Include="..\Avalon.Database\Avalon.Database.csproj"/>
    <ProjectReference Include="..\Avalon.Infrastructure\Avalon.Infrastructure.csproj"/>
    <ProjectReference Include="..\Avalon.ServiceDefaults\Avalon.ServiceDefaults.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helm\"/>
    <!-- The Web SDK makes every .json content. The chart's files (files/routes.json, #794) are read by the chart and the
         tests, never by the API, so they stay out of the build and publish output. -->
    <Content Remove="Helm\**"/>
  </ItemGroup>

  <PropertyGroup>
    <!--
      Off by default, on purpose. The generator boots the host to read the document, and
      without AVALON_OPENAPI_GENERATION_ONLY the host is a real API process: it needs its
      signing keys (#482, #801), which the generator does not load from user-secrets, so
      leaving it on would fail every ordinary build and every existing CI job.

      The generator also interrupts Main when the host STARTS, not when it is built, so
      the startup work after Build() - migrations, workers, the cache connection - runs
      unless AVALON_OPENAPI_GENERATION_ONLY tells the host (AvalonApiHost) to skip it. With
      it the host also makes a throwaway signing key in memory, so no key is needed.

      The docs workflow turns generation on, as .github/workflows/docs.yml shows:

        AVALON_OPENAPI_GENERATION_ONLY=true
        dotnet build src/Server/Avalon.Api -c Release -p:OpenApiGenerateDocuments=true
    -->
    <OpenApiGenerateDocuments Condition="'$(OpenApiGenerateDocuments)' == ''">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

</Project>
