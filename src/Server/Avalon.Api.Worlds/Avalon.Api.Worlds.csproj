<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The worlds API service (#794, design section 2.1): the world registry and its maintenance, world content and its
    live editing, characters, the views across worlds (/character, presence), public tooltips and link previews, and
    the balance workbench's proxy. It references the shared hosting, never another API service.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK's implicit usings, which the code moved here from Avalon.Api was written against. -->
    <Using Include="Microsoft.AspNetCore.Builder"/>
    <Using Include="Microsoft.AspNetCore.Hosting"/>
    <Using Include="Microsoft.AspNetCore.Http"/>
    <Using Include="Microsoft.AspNetCore.Routing"/>
    <Using Include="Microsoft.Extensions.Configuration"/>
    <Using Include="Microsoft.Extensions.DependencyInjection"/>
    <Using Include="Microsoft.Extensions.Hosting"/>
    <Using Include="Microsoft.Extensions.Logging"/>
    <Using Include="System.Net.Http.Json"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Avalon.Common\Avalon.Common.csproj"/>
    <ProjectReference Include="..\..\Shared\Avalon.Domain\Avalon.Domain.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Contract\Avalon.Api.Contract.csproj"/>
    <ProjectReference Include="..\Avalon.Api.Hosting\Avalon.Api.Hosting.csproj"/>
    <ProjectReference Include="..\Avalon.Balance.Contract\Avalon.Balance.Contract.csproj"/>
    <ProjectReference Include="..\Avalon.Combat\Avalon.Combat.csproj"/>
    <ProjectReference Include="..\Avalon.Database\Avalon.Database.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Auth\Avalon.Database.Auth.csproj"/>
    <ProjectReference Include="..\Avalon.Database.Character\Avalon.Database.Character.csproj"/>
    <ProjectReference Include="..\Avalon.Database.World\Avalon.Database.World.csproj"/>
    <ProjectReference Include="..\Avalon.Infrastructure\Avalon.Infrastructure.csproj"/>
    <ProjectReference Include="..\Avalon.World.Generation\Avalon.World.Generation.csproj"/>
  </ItemGroup>

</Project>
