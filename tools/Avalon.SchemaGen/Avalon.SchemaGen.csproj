<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The emitter version decides what the schema looks like, so this must track the version
      the packet contracts serialize with (src/Directory.Packages.props). Bumping one alone
      shows up as an unexplained schema diff.
    -->
    <PackageReference Include="protobuf-net" Version="3.4.21"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Avalon.Network.Packets\Avalon.Network.Packets.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Network.Packets.Abstractions\Avalon.Network.Packets.Abstractions.csproj"/>
  </ItemGroup>

</Project>
