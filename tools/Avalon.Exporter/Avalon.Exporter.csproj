<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No version here, deliberately. The emitter decides what the exported schema looks like,
      so it has to be the protobuf-net the packet contracts serialize with, and the version
      arrives from the server's central file through the Directory.Packages.props beside this
      one. Writing a version here is a restore error, which is the point.
    -->
    <PackageReference Include="protobuf-net"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Every artifact is exported by running the server's own types, never a copy of them: the
      crypto vectors run the real key derivation, the rotation vectors run the real layout
      generator, and the guid vectors read the real masks. A transcription would agree with
      whatever it transcribed, which is the failure these files exist to catch.
    -->
    <ProjectReference Include="..\..\src\Server\Avalon.World\Avalon.World.csproj"/>
    <ProjectReference Include="..\..\src\Server\Avalon.World.Generation\Avalon.World.Generation.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Common\Avalon.Common.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Domain\Avalon.Domain.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Network.Packets\Avalon.Network.Packets.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Network.Packets.Abstractions\Avalon.Network.Packets.Abstractions.csproj"/>
  </ItemGroup>

</Project>
