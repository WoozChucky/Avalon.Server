<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalon.Exporter.Emitters\Avalon.Exporter.Emitters.csproj"/>

    <!--
      NavmeshVectors.cs stays in the CLI rather than moving to the emitters library: it runs the
      real ChunkLayoutNavmeshBuilder and MapNavigator, which live in Avalon.World, and Avalon.World
      drags in Avalon.Database.World/.Auth/.Character (EF Core + Npgsql) through its own project
      references. The emitters library is exactly what the shared unit tests reference for their
      drift guards, so that database stack has to stay out of it, and the CLI is the only place
      allowed to carry it.
    -->
    <ProjectReference Include="..\..\src\Server\Avalon.World\Avalon.World.csproj"/>
    <ProjectReference Include="..\..\src\Server\Avalon.World.Generation\Avalon.World.Generation.csproj"/>

    <!-- ItemCatalog.cs is the only export that reads a database: the catalog is read through the
         EF model that defines the table, not hand-written SQL, so a second description of the same
         columns could drift from it with nothing to notice. -->
    <ProjectReference Include="..\..\src\Server\Avalon.Database.World\Avalon.Database.World.csproj"/>
    <ProjectReference Include="..\..\src\Shared\Avalon.Configuration\Avalon.Configuration.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by ItemCatalog.ConnectionString(), which binds configuration the same way the
         server's own design-time DbContext factories do. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
  </ItemGroup>

</Project>
