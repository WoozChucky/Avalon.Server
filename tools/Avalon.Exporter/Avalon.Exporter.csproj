<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalon.Exporter.Emitters\Avalon.Exporter.Emitters.csproj"/>

    <!--
      NavmeshVectors.cs stays in the CLI rather than moving to the emitters library: it runs the
      real ChunkLayoutNavmeshBuilder and MapNavigator, which live in Avalon.World, and Avalon.World
      drags in Avalon.Database.World/.Auth/.Character (EF Core + Npgsql) through its own project
      references. The emitters library is exactly what the shared unit tests reference for their
      drift guards, so that database stack has to stay out of it, and the CLI is the only place
      allowed to carry it.
    -->
    <ProjectReference Include="..\..\src\Server\Avalon.World\Avalon.World.csproj"/>
    <ProjectReference Include="..\..\src\Server\Avalon.World.Generation\Avalon.World.Generation.csproj"/>
  </ItemGroup>

</Project>
