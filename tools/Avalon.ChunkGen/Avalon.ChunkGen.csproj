<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The seeder's file DTOs and reader: the tool validates what it writes exactly as the World server's start-up will. -->
    <ProjectReference Include="..\..\src\Server\Avalon.Database.World\Avalon.Database.World.csproj"/>
    <!-- The real navmesh bake (ChunkLayoutNavmeshBuilder), as tools/Avalon.Exporter's navmesh vectors use it. -->
    <ProjectReference Include="..\..\src\Server\Avalon.World\Avalon.World.csproj"/>
    <ProjectReference Include="..\..\src\Server\Avalon.World.Generation\Avalon.World.Generation.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The art kit's model boxes (KitBounds.Load), measured from the kit by the "kit-bounds" command; the kit itself stays out of the repository. -->
    <None Include="Kit\kit-bounds.json" CopyToOutputDirectory="PreserveNewest"/>
    <!-- One building per file (BuildingRecipe.Load): kit pieces and collision proxies, relative to the building's anchor. -->
    <None Include="Recipes\**\*.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
